        local function makeDraggable(btn, stateVarName, onClickCallback)
            local dragging = false
            local dragStart = Vector2.new()
            local startPos = UDim2.new()
            local hasMoved = false
            local connectionMove, connectionEnd

            local switchBg = btn:FindFirstChild("SwitchBg")
            local switchCircle = switchBg and switchBg:FindFirstChild("SwitchCircle")

            btn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if btn.Parent == RightContainer then
                        local absPos = btn.AbsolutePosition
                        btn.Parent = gui
                        btn.Position = UDim2.new(0, absPos.X, 0, absPos.Y)
                    end

                    dragging = true
                    hasMoved = false
                    dragStart = Vector2.new(input.Position.X, input.Position.Y)
                    startPos = btn.Position

                    if connectionMove then connectionMove:Disconnect() end
                    if connectionEnd then connectionEnd:Disconnect() end

                    connectionMove = UserInputService.InputChanged:Connect(function(moveInput)
                        if dragging and (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) then
                            local currentPos = Vector2.new(moveInput.Position.X, moveInput.Position.Y)
                            local delta = currentPos - dragStart
                            if delta.Magnitude > 5 then
                                hasMoved = true
                            end
                            btn.Position = UDim2.new(
                                startPos.X.Scale, 
                                startPos.X.Offset + delta.X, 
                                startPos.Y.Scale, 
                                startPos.Y.Offset + delta.Y
                            )
                        end
                    end)

                    connectionEnd = input.Changed:Connect(function()
                        if input.UserInputState == Enum.UserInputState.End then
                            dragging = false
                            if connectionMove then connectionMove:Disconnect() end
                            if connectionEnd then connectionEnd:Disconnect() end

                            if not hasMoved then
                                pcall(onClickCallback)
                                local activeState = false
                                if stateVarName == "ANTI DESYNC" then activeState = State.autoBatToggled
                                elseif stateVarName == "AUTO RIGHT" then activeState = State.autoRightToggled
                                elseif stateVarName == "BAT AIMBOT" then activeState = State.batAimbotToggled
                                elseif stateVarName == "AUTO LEFT" then activeState = State.autoLeftToggled end

                                if switchBg and switchCircle then
                                    TweenService:Create(switchBg, TweenInfo.new(0.2), {
                                        BackgroundColor3 = activeState and Color3.fromRGB(255, 105, 180) or Color3.fromRGB(35, 35, 35)
