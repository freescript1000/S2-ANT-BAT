        local function startAutoLeft()
            stopAutoLeft()
            autoLeftPhase = 1
            autoLeftConn = RunService.Stepped:Connect(function()
                if not State.autoLeftToggled then return end
                local c = LP.Character
                if not c then return end
                local root = c:FindFirstChild("HumanoidRootPart")
                local hum = c:FindFirstChildOfClass("Humanoid")
                if not root or not hum then return end
                if not bypassPart or bypassPart.Parent ~= c then createProxy() end
                
               local targetPos
                local speed = State.GoingSpeed
                if autoLeftPhase == 1 then targetPos = POS_L1
                elseif autoLeftPhase == 2 then targetPos = POS_L2
                elseif autoLeftPhase == 3 then targetPos = POS_L3; speed = State.StealSpeed
                elseif autoLeftPhase == 4 then targetPos = POS_L4; speed = State.StealSpeed
                end
                if targetPos then
                    local dist = (targetPos - root.Position).Magnitude
                    if dist < 1 then
                        autoLeftPhase = autoLeftPhase + 1
                        if autoLeftPhase > 4 then
                            State.autoLeftToggled = false
                            stopAutoLeft()
                            return
                        end
                        return
                    end
                    local dir = (targetPos - root.Position)
                    local moveDir = Vector3.new(dir.X, 0, dir.Z).Unit
                    hum:Move(moveDir, false)
                    if bypassPart then bypassPart.AssemblyLinearVelocity = moveDir * speed end
