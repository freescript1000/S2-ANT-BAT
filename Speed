                local yDiff = targetRoot.Position.Y - hrp.Position.Y
                local yVelocity = hrp.AssemblyLinearVelocity.Y

                if yDiff > 0.5 then
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        hrp.AssemblyLinearVelocity.X,
                        math.clamp(yDiff * 4, 15, 60),
                        hrp.AssemblyLinearVelocity.Z
                    )
                elseif yDiff < -0.5 then
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        hrp.AssemblyLinearVelocity.X,
                        yVelocity - 5,
                        hrp.AssemblyLinearVelocity.Z
                    )
                end

                local moveDirection = (targetRoot.Position - hrp.Position)
                local horizontalDirection = Vector3.new(moveDirection.X, 0, moveDirection.Z)
                
                if horizontalDirection.Magnitude > 2 then
                    local direction = horizontalDirection.Unit
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        direction.X * 55,
                        hrp.AssemblyLinearVelocity.Y,
                        direction.Z * 55
                    )
                else
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        targetRoot.AssemblyLinearVelocity.X,
                        hrp.AssemblyLinearVelocity.Y,
                        targetRoot.AssemblyLinearVelocity.Z
                    )
                end

                tryHitBat()
            end
        end)

