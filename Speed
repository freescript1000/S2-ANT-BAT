                        game:GetService("NetworkClient"):SetOutgoingKBPSLimit(80000)
                    end)
                end
            end

            toggleBtn.MouseButton1Click:Connect(togglePingLagger)
            setOnVisual(false)

            -- Sürükleme Özelliği
            local isDragging, dragStart, startPos = false, nil, nil
            mainFrameWPL.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = true
                    dragStart = input.Position
                    startPos = mainFrameWPL.Position
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if not isDragging then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    local delta = input.Position - dragStart
                    mainFrameWPL.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                end
            end)
            mainFrameWPL.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = false
                end
            end)
        end

