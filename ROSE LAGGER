--==================================================  
-- STATE & LOGIC  
--==================================================
local active           = false  
local boundKey         = Enum.KeyCode.V  
local selectedPlatform = "PC"  
local defaultPowers    = { PC = 100000, MOBILE = 65000 }  
local currentPower     = defaultPowers.PC  
local waitingForKey    = false   

local saved = LoadConfig()  
if saved then  
local key = Enum.KeyCode[saved.Keybind]  
if key then boundKey = key end  
if saved.Power and saved.Power > 0 then  
currentPower = math.floor(saved.Power)  
end  
if saved.Platform == "PC" or saved.Platform == "MOBILE" then  
selectedPlatform = saved.Platform  
end  
end

local function formatPower(num)  
if num >= 1000 then  
return string.format("%dK", math.floor(num / 1000 + 0.5))  
end  
return tostring(num)  
end

local function updatePowerDisplay()  
powerText.Text = formatPower(currentPower)  
powerInput.Text = tostring(currentPower)  
end

local function highlightPlatform(platform)  
pcBtn.BackgroundColor3 = C.Card2  
mobileBtn.BackgroundColor3 = C.Card2  
pcBtn.TextColor3 = C.White  
mobileBtn.TextColor3 = C.White  
if platform == "PC" then  
pcBtn.BackgroundColor3 = C.Blue  
pcBtn.TextColor3 = C.White  
else  
mobileBtn.BackgroundColor3 = C.Blue  
mobileBtn.TextColor3 = C.White  
end  
end

local function setActive(state)  
active = state  
if state then  
statusLabel.Text       = "ON"  
statusLabel.TextColor3 = C.BrightBlue  
activateButton.BackgroundColor3 = C.Blue  
activateButton.TextColor3       = C.White  
ringStroke.Color = C.BrightBlue  
ringGradient.Color = ColorSequence.new({  
ColorSequenceKeypoint.new(0.00, C.Blue),  
ColorSequenceKeypoint.new(0.38, C.BrightBlue),  
ColorSequenceKeypoint.new(0.50, Color3.fromRGB(255, 180, 220)),  
ColorSequenceKeypoint.new(0.62, C.BrightBlue),  
ColorSequenceKeypoint.new(1.00, C.Blue),  
})  
startBypass(currentPower)  
else  
statusLabel.Text       = "OFF"  
statusLabel.TextColor3 = C.DimText  
activateButton.BackgroundColor3 = C.Card  
activateButton.TextColor3       = C.Blue  
ringStroke.Color = C.Blue  
ringGradient.Color = ColorSequence.new({  
ColorSequenceKeypoint.new(0.00, C.DarkBlue),  
ColorSequenceKeypoint.new(0.38, C.Blue),  
ColorSequenceKeypoint.new(0.50, C.BrightBlue),  
ColorSequenceKeypoint.new(0.62, C.Blue),  
ColorSequenceKeypoint.new(1.00, C.DarkBlue),  
})  
stopBypass()  
end  
activateButton.Text = state and "DEACTIVATE" or "ACTIVATE"  
end

local function setPlatform(platform)  
selectedPlatform = platform  
highlightPlatform(platform)  
currentPower = defaultPowers[platform]  
updatePowerDisplay()  
if active then startBypass(currentPower) end  
SaveConfig(boundKey, currentPower, platform)  
end

powerInput.FocusLost:Connect(function()  
local num = tonumber(powerInput.Text)  
if num and num > 0 then  
currentPower = math.floor(num)  
updatePowerDisplay()  
if active then startBypass(currentPower) end  
SaveConfig(boundKey, currentPower, selectedPlatform)  
else  
powerInput.Text = tostring(currentPower)  
end  
end)

pcBtn.Activated:Connect(function() setPlatform("PC") end)  
mobileBtn.Activated:Connect(function() setPlatform("MOBILE") end)

kbButton.Activated:Connect(function()  
waitingForKey = true  
kbButton.Text = "[?]"  
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)  
if waitingForKey then  
local newKey = nil  
if input.UserInputType == Enum.UserInputType.Keyboard then  
newKey = input.KeyCode  
elseif input.UserInputType == Enum.UserInputType.Gamepad1 then  
newKey = input.KeyCode  
end  
if newKey and newKey ~= Enum.KeyCode.Unknown then  
boundKey = newKey  
kbButton.Text = "[" .. newKey.Name .. "]"  
waitingForKey = false  
SaveConfig(boundKey, currentPower, selectedPlatform)  
end  
return  
end  
if not gameProcessed then  
if input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType == Enum.UserInputType.Gamepad1 then  
if input.KeyCode == boundKey then  
setActive(not active)  
end  
end  
end  
end)

activateButton.Activated:Connect(function() setActive(not active) end)

activateButton.MouseEnter:Connect(function()  
local target = active and Color3.fromRGB(255, 100, 180) or C.Card2  
TweenService:Create(activateButton, TweenInfo.new(0.1), {BackgroundColor3 = target}):Play()  
end)  
activateButton.MouseLeave:Connect(function()  
local target = active and C.Blue or C.Card  
TweenService:Create(activateButton, TweenInfo.new(0.1), {BackgroundColor3 = target}):Play()  
end)

--==================================================  
-- DRAGGING  
--==================================================
local dragging, dragStart, startPos = false, nil, nil  
main.InputBegan:Connect(function(input)  
if input.UserInputType == Enum.UserInputType.MouseButton1  
or input.UserInputType == Enum.UserInputType.Touch then  
dragging   = true  
dragStart  = input.Position  
startPos   = main.Position  
end  
end)

UserInputService.InputChanged:Connect(function(input)  
if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement  
or input.UserInputType == Enum.UserInputType.Touch) then  
local delta  = input.Position - dragStart  
main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,  
startPos.Y.Scale, startPos.Y.Offset + delta.Y)  
end  
end)

UserInputService.InputEnded:Connect(function(input)  
if input.UserInputType == Enum.UserInputType.MouseButton1  
or input.UserInputType == Enum.UserInputType.Touch then  
dragging   = false  
end  
end)

