--==================================================  
-- CONFIG (save keybind & power)  
--==================================================
local CONFIG_FILE = "RoseHubBypassConfig.json"
local function SaveConfig(key, power, platform)  
local data = {  
Keybind = key.Name,  
Power = power,  
Platform = platform or "PC"  
}  
pcall(function()  
writefile(CONFIG_FILE, HttpService:JSONEncode(data))  
end)  
end

local function LoadConfig()  
local exists = false  
pcall(function() exists = isfile(CONFIG_FILE) end)  
if not exists then return nil end  
local data = nil  
pcall(function()  
data = HttpService:JSONDecode(readfile(CONFIG_FILE))  
end)  
return data  
end

